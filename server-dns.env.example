# GHOST-HUNT // C2 KIT-DNS — server config
# Copy to server-dns.env, fill in, then:  bash bootstrap-dns-server.sh server-dns.env

# Controlled domain for the DNS tunnel. Must be authoritative on this VPS —
# set NS glue records at the registrar (ns1/ns2 -> this VPS IP) BEFORE deploying.
DOMAIN=cdn-cache-<random>.com

# UDP/TCP port dnscat2 binds. 53 = standard authoritative DNS (use 53 for real ops).
PORT=53

# Shared secret used by the Python Method-B client (XOR key derivation) and
# iodine (Method C, -P <password>). Generate with:  pwgen -s 48 1
# PASSWORD=
