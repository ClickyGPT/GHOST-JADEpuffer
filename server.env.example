# GHOST-HUNT // C2 KIT — server config
# Copy to server.env, fill in, then:  bash bootstrap-server.sh server.env

# Legit-looking domain with an A record already pointing at this VPS.
DOMAIN=cdn-analytics-<random>.com

# Contact email for the Let's Encrypt certificate (not sensitive, but avoid obvious opsec leaks).
EMAIL=admin@cdn-analytics-<random>.com

# Optional: pre-generate a key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to auto-generate a fresh Fernet key at deploy time.
# FERNET_KEY=

# Keep port 22 open for operator SSH (key-only auth). Set to "no" for maximum lockdown.
ALLOW_SSH=yes
